# Copy this file to .env and fill in real values before running.
# Locally, the defaults below work fine with zero setup (SQLite, dev secret key).

# Leave unset locally to use SQLite. On Render/Railway, set this to your
# PostgreSQL connection string (they give you one automatically when you
# add a Postgres database).
DATABASE_URL=

# Change this to any long random string before deploying publicly.
# This signs your JWTs -- if it leaks, anyone can forge login tokens.
JWT_SECRET_KEY=dev-secret-change-this-in-production

# Set this to your deployed frontend URL (e.g. https://cryptovision.vercel.app)
# so the backend's CORS policy only allows your own frontend to call it.
# Leave as * for local development.
FRONTEND_ORIGIN=*

# Optional. CryptoCompare's news feed became key-only in 2025; without a key
# the news widget just shows "No news available". Free key: cryptocompare.com
CRYPTOCOMPARE_API_KEY=
